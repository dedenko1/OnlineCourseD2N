<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/OnlineCourseD2N.Shared/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/OnlineCourseD2N.Shared/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="OnlineCourseD2N.Web.styles.css" />
    <link rel="icon" type="image/png" href="_content/OnlineCourseD2N.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
        window.webScreenshot = {
            takeAndDownload: function () {
                // 1. Ambil elemen body
                html2canvas(document.body).then(canvas => {
                    // 2. Ubah ke format gambar (Base64)
                    var image = canvas.toDataURL("image/png");

                    // 3. Buat link palsu untuk trigger download
                    var link = document.createElement('a');
                    link.download = 'screenshot_' + new Date().toISOString().slice(0,19).replace(/[-T:]/g,"") + '.png';
                    link.href = image;
                    link.click();
                });
            }
        };
    </script>
    <script src="_content/OnlineCourseD2N.Shared/camera.js"></script>
    <script>
        window.geolocationInterop = {
            getCurrentPosition: function () {
                return new Promise((resolve, reject) => {
                    // Cek apakah browser support
                    if (!navigator.geolocation) {
                        resolve(null);
                        return;
                    }

                    navigator.geolocation.getCurrentPosition(
                        (position) => {
                            // Sukses: Kirim Lat/Long balik ke C#
                            resolve({
                                latitude: position.coords.latitude,
                                longitude: position.coords.longitude
                            });
                        },
                        (error) => {
                            // Gagal/Ditolak User
                            console.error("Geolocation error:", error.message);
                            resolve(null);
                        },
                        {
                            enableHighAccuracy: true, // Minta GPS akurat
                            timeout: 20000,            // Waktu tunggu 5 detik
                            maximumAge: 0
                        }
                    );
                });
            }
        };
    </script>

    <script>
        window.ttsInterop = {
            speak: function (text) {
                // 1. Cek apakah browser support
                if (!('speechSynthesis' in window)) {
                    console.warn("Browser ini tidak mendukung Text-to-Speech");
                    return;
                }

                // 2. Stop suara sebelumnya (biar gak numpuk/tabrakan)
                window.speechSynthesis.cancel();

                // 3. Buat objek ucapan
                const utterance = new SpeechSynthesisUtterance(text);

                // 4. Atur Bahasa (Opsional, biar logatnya Indonesia)
                // Kalau browser punya suara Indo, dia bakal pakai. Kalau enggak, fallback ke default.
                utterance.lang = 'id-ID';
                utterance.rate = 1.0; // Kecepatan bicara (1.0 normal)
                utterance.pitch = 1.0; // Nada bicara

                // 5. Mulai bicara
                window.speechSynthesis.speak(utterance);
            },

            cancel: function () {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                }
            }
        };
    </script>

    <script>
        window.shareInterop = {
            share: async function (title, text, url) {
                // 1. Cek apakah browser support Web Share API
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: title,
                            text: text,
                            url: url
                        });
                        console.log("Berhasil share native!");
                    } catch (err) {
                        console.error("Error sharing:", err);
                    }
                } else {
                    // 2. FALLBACK: Jika di Laptop (Chrome Windows kadang gak support),
                    // kita copy URL ke clipboard manual
                    try {
                        await navigator.clipboard.writeText(url);
                        alert("Link berhasil disalin ke clipboard!\n" + url);
                    } catch (err) {
                        // Kalau copy juga gagal, tampilkan prompt manual
                        prompt("Browser tidak support share otomatis. Silakan copy link ini:", url);
                    }
                }
            }
        };
    </script>

    <script>
        window.getBatteryLevel = async () => {
            if (navigator.getBattery) {
                // Hanya jalan di Chrome/Edge
                const battery = await navigator.getBattery();
                return battery.level; // Return 0.0 - 1.0
            }
            return 1.0; // Fallback untuk Firefox/Safari (Pura-pura 100%)
        };
    </script>
</body>

</html>