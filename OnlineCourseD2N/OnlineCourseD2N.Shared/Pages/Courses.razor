@page "/courses"
@attribute [Authorize]
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using OnlineCourseD2N.Shared.Models
@using OnlineCourseD2N.Shared.Services
@using System.Security.Claims

@* --- INJECT SERVICES LENGKAP --- *@
@inject CourseService CourseService
@inject TrainerService TrainerService
@inject IGeolocationService GeoService
@inject IGeocodingService GeocodingService
@inject IConnectivityService ConnectivityService
@inject ITextToSpeechService TTSService
@inject IMapService MapService
@inject IShareService ShareService
@inject IBatteryService BatteryService
@inject ICameraService CameraService
@inject IScreenshotService ScreenshotService
@inject AuthenticationStateProvider AuthStateProvider
@* ------------------------------ *@

<PageTitle>Courses - RuangLes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-0">Manajemen Courses</h3>
        <small class="text-muted">Kelola materi pembelajaran Anda</small>
    </div>

    <div class="d-flex gap-2">
        <span class="badge @(batteryLevel < 0.2 ? "bg-danger" : "bg-light text-dark") border d-flex align-items-center"
              title="Sumber Daya: @powerSource">
            <span class="me-1">
                @(powerSource.Equals("AC", StringComparison.OrdinalIgnoreCase) ? "⚡" : "🔋")
            </span>
            @((batteryLevel * 100).ToString("0"))%
        </span>

        <button class="btn btn-outline-dark btn-sm" @onclick="TakeScreenshot" title="Simpan Layar">
            📸
        </button>
    </div>
</div>

@if (courses == null || trainers == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Memuat data course...</p>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@alertType fade show position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
             role="alert" style="z-index: 9999; min-width: 320px; border-radius: 50px;">
            <div class="d-flex justify-content-between align-items-center px-2">
                <span class="fw-medium">@alertMessage</span>
                <button type="button" class="btn-close ms-2" @onclick="() => alertMessage = null"></button>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input class="form-control border-start-0 ps-0"
                       placeholder="Cari judul, deskripsi, atau trainer..."
                       @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>
        </div>

        @* 🔥 REVISI: Tombol Tambah HANYA UNTUK ADMIN *@
        @if (currentUserRole == "Admin")
        {
            <div class="col-md-4 text-end">
                <button class="btn btn-primary w-100 shadow-sm fw-bold" @onclick="ShowAddModal">
                    + Tambah Course Baru
                </button>
            </div>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var c in filteredCourses ?? [])
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 hover-lift">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(c.CoverImage))
                        {
                            <img src="@($"http://localhost:5034/uploads/{c.CoverImage}")"
                                 class="card-img-top"
                                 alt="@c.Title"
                                 style="height: 180px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/300x180?text=No+Image'" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 180px;">
                                <span class="text-muted"><i class="bi bi-image fs-1"></i></span>
                            </div>
                        }

                        <span class="position-absolute top-0 end-0 badge bg-primary m-2 shadow">
                            @c.Category
                        </span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title fw-bold text-truncate" title="@c.Title">@c.Title</h5>

                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-person-circle text-muted me-2"></i>
                            <small class="text-muted">@(c.Trainer?.Name ?? "Tanpa Trainer")</small>
                        </div>

                        <p class="card-text text-muted small two-lines">
                            @c.Description
                        </p>

                        @if (c.Latitude != null && c.Longitude != null)
                        {
                            <div class="d-grid mb-2">
                                <button class="btn btn-sm btn-outline-light text-primary border-0 text-start ps-0" @onclick="() => OpenMap(c)">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    @(string.IsNullOrEmpty(c.LocationAddress) ? "Lihat Peta" : c.LocationAddress)
                                </button>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle me-1" title="Dengarkan" @onclick="() => ReadCourseDescription(c)">🔊</button>
                            <button class="btn btn-outline-success btn-sm rounded-circle" title="Bagikan" @onclick="() => ShareCourse(c)">📤</button>
                        </div>

                        <div>
                            @* Tombol Detail (Semua bisa lihat) *@
                            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => ViewDetail(c.CourseId)">Detail</button>

                            @* 🔥 REVISI: Tombol Edit & Hapus HANYA UNTUK ADMIN *@
                            @if (currentUserRole == "Admin")
                            {
                                <div class="btn-group ms-1">
                                    <button class="btn btn-light btn-sm text-warning" @onclick="() => ShowEditModal(c)"><i class="bi bi-pencil-fill"></i></button>
                                    <button class="btn btn-light btn-sm text-danger" @onclick="() => AskDeleteCourse(c)"><i class="bi bi-trash-fill"></i></button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (filteredCourses?.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <p>Tidak ada course yang ditemukan.</p>
        </div>
    }

    @* --- MODAL FORM (Hanya Admin yang bisa trigger ini via tombol) --- *@
    @if (isModalVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">
                            @(currentCourse.CourseId == 0 ? "✨ Tambah Course Baru" : "✏️ Edit Course")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="currentCourse" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Judul Course</label>
                                    <InputText class="form-control" @bind-Value="currentCourse.Title" placeholder="Contoh: Belajar C# Dasar" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Kategori</label>
                                    <InputText class="form-control" @bind-Value="currentCourse.Category" placeholder="Programming, Design, dll" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold">Deskripsi</label>
                                    <InputTextArea class="form-control" @bind-Value="currentCourse.Description" rows="3" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Durasi (Jam)</label>
                                    <InputNumber class="form-control" @bind-Value="currentCourse.Duration" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Level</label>
                                    <InputSelect class="form-select" @bind-Value="currentCourse.Level">
                                        <option value="">Pilih Level</option>
                                        <option value="Beginner">Beginner</option>
                                        <option value="Intermediate">Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Trainer</label>
                                    @* Karena Admin yang input, dia bebas pilih Trainer *@
                                    <InputSelect class="form-select" @bind-Value="currentCourse.TrainerId">
                                        <option value="0">-- Pilih Trainer --</option>
                                        @foreach (var t in trainers)
                                        {
                                            <option value="@t.TrainerId">@t.Name</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-12 bg-light p-3 rounded border">
                                    <label class="form-label fw-bold text-primary">📍 Lokasi Offline (Venue)</label>
                                    <div class="input-group mb-2">
                                        <button type="button" class="btn btn-outline-primary" @onclick="GetCurrentLocation" disabled="@isLoadingLocation">
                                            @if (isLoadingLocation)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <span>Ambil GPS Saya</span>
                                            }
                                        </button>
                                        <InputNumber class="form-control" @bind-Value="currentCourse.Latitude" placeholder="Latitude" />
                                        <InputNumber class="form-control" @bind-Value="currentCourse.Longitude" placeholder="Longitude" />
                                    </div>
                                    <InputText class="form-control" @bind-Value="currentCourse.LocationAddress" placeholder="Alamat otomatis terisi..." readonly />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold">Cover Image</label>
                                    <div class="d-flex gap-2 mb-2">
                                        <button type="button" class="btn btn-secondary" @onclick="HandleCameraStart">📸 Ambil Foto</button>
                                        <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(currentCourse.CoverImage))
                                    {
                                        <div class="p-2 border rounded text-center bg-light">
                                            <img src="@($"http://localhost:5034/uploads/{currentCourse.CoverImage}")" height="100" class="rounded shadow-sm" />
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="modal-footer mt-4 px-0 pb-0 border-0">
                                <button class="btn btn-light" type="button" @onclick="CloseModal">Batal</button>
                                <button class="btn btn-primary px-4 fw-bold" type="submit">
                                    @(currentCourse.CourseId == 0 ? "Simpan Data" : "Update Data")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- MODAL HAPUS --- *@
    @if (CourseToDelete != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Konfirmasi Hapus</h5>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-circle text-danger fs-1 mb-3"></i>
                        <p class="mb-0">Apakah Anda yakin ingin menghapus course:</p>
                        <h5 class="fw-bold">@CourseToDelete.Title</h5>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button class="btn btn-secondary px-4" @onclick="CancelDelete">Batal</button>
                        <button class="btn btn-danger px-4" @onclick="ConfirmDelete">Ya, Hapus</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- MODAL KAMERA --- *@
    @if (isCameraOpen)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.9); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-black">
                    <div class="modal-header border-0">
                        <h5 class="modal-title text-white">Ambil Foto</h5>
                        <button class="btn-close btn-close-white" @onclick="CancelCamera"></button>
                    </div>
                    <div class="modal-body p-0 text-center">
                        <video id="cameraVideoElement" autoplay playsinline style="width: 100%; max-height: 400px;"></video>
                    </div>
                    <div class="modal-footer border-0 justify-content-center bg-black">
                        <button class="btn btn-light rounded-circle p-3 shadow" style="width: 60px; height: 60px;"
                                onclick="window.cameraInterop.capturePhoto()">
                            <div class="bg-danger rounded-circle w-100 h-100"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Course>? courses;
    private List<Course>? filteredCourses;
    private List<Trainer>? trainers;
    private Course currentCourse = new();
    private Course? CourseToDelete;

    private bool isModalVisible = false;
    private bool isCameraOpen = false;
    private bool isLoadingLocation = false;

    private string searchTerm = string.Empty;
    private string? alertMessage;
    private string? alertType;
    private System.Timers.Timer? alertTimer;

    private double batteryLevel = 1.0;
    private string powerSource = "Unknown";

    private int currentUserId;
    private string currentUserRole = "";

    private string SearchTerm
    {
        get => searchTerm;
        set { searchTerm = value; ApplySearch(); }
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Cek User Info (Role & ID)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserRole = user.FindFirst(c => c.Type == ClaimTypes.Role)?.Value ?? "";

            var idString = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idString, out int id))
            {
                currentUserId = id;
            }
        }

        try
        {
            batteryLevel = await BatteryService.CheckLevel();
            powerSource = BatteryService.CheckPowerSource();
        }
        catch
        {
            batteryLevel = 1.0;
            powerSource = "AC";
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        courses = await CourseService.GetAllAsync();
        trainers = await TrainerService.GetAllAsync();
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            filteredCourses = courses;
        else
            filteredCourses = courses?
                .Where(c => (c.Title?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (c.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (c.Trainer?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
    }

    // --- FITUR NATIVE SERVICES ---

    private async Task ShareCourse(Course c)
    {
        await ShareService.ShareTextAsync($"Belajar {c.Title}", $"Cek course: {c.Title}. {c.Description}", $"https://ruangles.com/c/{c.CourseId}");
    }

    private async Task OpenMap(Course c)
    {
        if (c.Latitude.HasValue && c.Longitude.HasValue)
            await MapService.OpenMapAsync(c.Latitude.Value, c.Longitude.Value, c.Title);
        else
            ShowAlert("Lokasi belum diset.", "warning");
    }

    private async Task ReadCourseDescription(Course c)
    {
        await TTSService.SpeakAsync(c.Description ?? "Tidak ada deskripsi");
    }

    private async Task TakeScreenshot()
    {
        await ScreenshotService.CaptureAndShareAsync();
    }

    private async Task GetCurrentLocation()
    {
        isLoadingLocation = true;
        try
        {
            var loc = await GeoService.GetCurrentLocationAsync();
            if (loc != null)
            {
                currentCourse.Latitude = loc.Value.Latitude;
                currentCourse.Longitude = loc.Value.Longitude;

                var address = await GeocodingService.GetAddressFromCoordinatesAsync(loc.Value.Latitude, loc.Value.Longitude);
                if (!string.IsNullOrEmpty(address))
                {
                    currentCourse.LocationAddress = address;
                    ShowAlert("Lokasi & Alamat ditemukan!", "success");
                }
                else
                {
                    ShowAlert("Koordinat ditemukan.", "success");
                }
            }
            else ShowAlert("Gagal ambil lokasi.", "warning");
        }
        catch (Exception ex) { ShowAlert($"Error GPS: {ex.Message}", "danger"); }
        finally { isLoadingLocation = false; }
    }

    private async Task HandleCameraStart()
    {
        isCameraOpen = true;
        StateHasChanged();
        await Task.Delay(100);

        var stream = await CameraService.TakePhotoAsync();

        if (stream != null)
        {
            var fileName = await CourseService.UploadStreamAsync(stream, currentCourse.CoverImage);
            currentCourse.CoverImage = fileName;
            ShowAlert("Foto tersimpan!", "success");
        }

        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task CancelCamera()
    {
        isCameraOpen = false;
        StateHasChanged();
    }

    // --- CRUD ---

    private void ShowAddModal()
    {
        currentCourse = new();
        isModalVisible = true;
    }

    private void ShowEditModal(Course c)
    {
        currentCourse = new Course
        {
            CourseId = c.CourseId,
            Title = c.Title,
            Description = c.Description,
            Category = c.Category,
            Duration = c.Duration,
            Level = c.Level,
            CoverImage = c.CoverImage,
            Latitude = c.Latitude,
            Longitude = c.Longitude,
            LocationAddress = c.LocationAddress,
            TrainerId = c.TrainerId
        };
        isModalVisible = true;
    }

    private void CloseModal() { isModalVisible = false; }

    private async Task HandleSubmit()
    {
        if (!ConnectivityService.IsConnected()) { ShowAlert("Anda Offline!", "danger"); return; }

        bool success = currentCourse.CourseId == 0
            ? await CourseService.AddAsync(currentCourse)
            : await CourseService.UpdateAsync(currentCourse.CourseId, currentCourse);

        if (success)
        {
            ShowAlert("Data berhasil disimpan!", "success"); await LoadData(); CloseModal();
        }
        else
        {
            ShowAlert("Gagal menyimpan data.", "danger");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var fileName = await CourseService.UploadCoverAsync(e.File, currentCourse.CoverImage);
        if (!string.IsNullOrEmpty(fileName)) currentCourse.CoverImage = fileName;
    }

    private void AskDeleteCourse(Course c) => CourseToDelete = c;
    private void CancelDelete() => CourseToDelete = null;

    private async Task ConfirmDelete()
    {
        if (CourseToDelete != null)
        {
            bool success = await CourseService.DeleteAsync(CourseToDelete.CourseId);
            if (success)
            {
                ShowAlert("Terhapus!", "success"); await LoadData();
            }
            else
            {
                ShowAlert("Gagal hapus.", "danger");
            }
            CourseToDelete = null;
        }
    }

    private void ViewDetail(int id)
    {
        if (batteryLevel < 0.20 && !powerSource.Equals("AC", StringComparison.OrdinalIgnoreCase))
            ShowAlert("Baterai Lemah! Charge dulu.", "warning");

        Nav.NavigateTo($"/courses/{id}");
    }

    private void ShowAlert(string message, string type = "success", int durationMs = 3000)
    {
        alertMessage = message; alertType = type;
        alertTimer?.Stop();
        alertTimer = new System.Timers.Timer(durationMs);
        alertTimer.Elapsed += (s, e) => { alertMessage = null; alertTimer?.Stop(); InvokeAsync(StateHasChanged); };
        alertTimer.Start();
        StateHasChanged();
    }

    public void Dispose() => alertTimer?.Dispose();
}