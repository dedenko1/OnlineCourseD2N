@page "/trainers/{id:int}"
@inject TrainerService TrainerService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject ICameraService CameraService
@inject IConnectivityService ConnectivityService

@using OnlineCourseD2N.Shared.Models
@using OnlineCourseD2N.Shared.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IShareService ShareService

<PageTitle>@(trainer?.Name ?? "Profil Trainer") - RuangLes</PageTitle>

<div class="container-fluid px-0 pb-5">

    @* --- HEADER --- *@
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-outline-secondary rounded-circle me-3 shadow-sm" style="width: 40px; height: 40px;" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div>
            <h5 class="text-muted mb-0 small text-uppercase ls-1">Profil Pengajar</h5>
            @if (trainer != null)
            {
                <h2 class="fw-bold text-primary mb-0">@trainer.Name</h2>
            }
            else
            {
                <div class="placeholder-glow"><span class="placeholder col-6"></span></div>
            }
        </div>

        @* 🔥 TOMBOL EDIT (Hanya Muncul jika ini Profil Saya) *@
        @if (canEdit)
        {
            <div class="ms-auto">
                <button class="btn btn-warning shadow-sm fw-bold" @onclick="ShowEditModal">
                    <i class="bi bi-pencil-square me-2"></i> Edit Profil
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Memuat profil trainer...</p>
        </div>
    }
    else if (trainer == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-person-x fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">Trainer Tidak Ditemukan</h4>
            <button class="btn btn-primary mt-3" @onclick="GoBack">Kembali</button>
        </div>
    }
    else
    {
        <div class="row g-4">

            @* --- KIRI: PROFIL TRAINER (Sticky) --- *@
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 20px; z-index: 1;">
                    <div class="card shadow-sm border-0 rounded-3 text-center p-4">
                        <div class="position-relative mx-auto mb-3" style="width: 150px; height: 150px;">
                            @if (!string.IsNullOrEmpty(trainer.FotoProfil))
                            {
                                <img src="@($"http://localhost:5034/uploads/{trainer.FotoProfil}")"
                                     class="rounded-circle shadow border border-4 border-white w-100 h-100"
                                     alt="@trainer.Name"
                                     style="object-fit: cover"
                                     onerror="this.src = 'https://via.placeholder.com/150?text=User'" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center w-100 h-100 shadow border border-4 border-white">
                                    <i class="bi bi-person fs-1 text-secondary"></i>
                                </div>
                            }
                            <div class="position-absolute bottom-0 end-0 bg-success rounded-circle border border-2 border-white p-2"
                                 title="Verified Trainer" data-bs-toggle="tooltip"></div>
                        </div>

                        <h3 class="fw-bold mb-1">@trainer.Name</h3>
                        <div class="mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                @trainer.Expertise
                            </span>
                        </div>

                        <p class="text-muted fst-italic mb-4 small">
                            "@(trainer.Bio ?? "Tidak ada bio.")"
                        </p>

                        <div class="d-grid gap-2">
                            <a href="mailto:@trainer.Email" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-envelope me-2"></i> @trainer.Email
                            </a>
                            <button class="btn btn-primary btn-sm" @onclick="ShareTrainer">
                                <i class="bi bi-share-fill me-2"></i> Bagikan Profil
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* --- KANAN: DAFTAR COURSE --- *@
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-album me-2 text-primary"></i>Materi Ajar
                    </h4>
                    <span class="badge bg-secondary">@(trainer.Courses?.Count ?? 0) Course</span>
                </div>

                @if (trainer.Courses == null || trainer.Courses.Count == 0)
                {
                    <div class="card border-0 shadow-sm p-5 text-center bg-light rounded-3">
                        <i class="bi bi-journal-x fs-1 text-muted mb-3"></i>
                        <h5 class="text-muted">Belum ada course yang dibuat.</h5>
                        <p class="small text-secondary">Trainer ini sedang menyiapkan materi terbaiknya.</p>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var course in trainer.Courses)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 hover-lift">
                                    <div class="position-relative">
                                        @if (!string.IsNullOrEmpty(course.CoverImage))
                                        {
                                            <img src="@($"http://localhost:5034/uploads/{course.CoverImage}")"
                                                 class="card-img-top"
                                                 style="height: 140px; object-fit: cover;"
                                                 alt="@course.Title"
                                                 onerror="this.src = 'https://via.placeholder.com/300x140?text=No+Image'" />
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 140px;">
                                                <i class="bi bi-image text-muted fs-2"></i>
                                            </div>
                                        }
                                        <span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2 shadow-sm">
                                            @course.Level
                                        </span>
                                    </div>

                                    <div class="card-body">
                                        <h6 class="card-title fw-bold text-truncate" title="@course.Title">
                                            @course.Title
                                        </h6>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="text-muted"><i class="bi bi-tag"></i> @course.Category</small>
                                            <small class="text-muted"><i class="bi bi-clock"></i> @course.Duration jam</small>
                                        </div>
                                        <p class="card-text text-muted small two-lines">
                                            @course.Description
                                        </p>
                                    </div>

                                    <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                                        <button class="btn btn-outline-primary btn-sm w-100 rounded-pill"
                                                @onclick='() => Nav.NavigateTo($"/courses/{course.CourseId}")'>
                                            Lihat Materi <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* --- MODAL EDIT PROFIL --- *@
    @if (isEditModalVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title fw-bold">✏️ Edit Profil Saya</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>

                    <EditForm Model="editTrainer" OnValidSubmit="HandleUpdate">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-md-12 mb-2">
                                    <label class="form-label fw-bold">Nama Lengkap</label>
                                    <InputText class="form-control" @bind-Value="editTrainer.Name" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label fw-bold">Keahlian</label>
                                    <InputText class="form-control" @bind-Value="editTrainer.Expertise" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label fw-bold">Email</label>
                                    <InputText class="form-control" @bind-Value="editTrainer.Email" />
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">Bio</label>
                                    <InputTextArea class="form-control" @bind-Value="editTrainer.Bio" rows="3" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Foto Profil</label>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="HandleCameraStart">
                                            📸 Kamera
                                        </button>
                                        <InputFile OnChange="HandleFileSelected" class="form-control form-control-sm" accept="image/*" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button class="btn btn-light" type="button" @onclick="CloseModal">Batal</button>
                            <button class="btn btn-primary fw-bold px-4" type="submit">Simpan Perubahan</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @* --- MODAL KAMERA --- *@
    @if (isCameraOpen)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.9); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-black">
                    <div class="modal-header border-0">
                        <h5 class="modal-title text-white">Ambil Foto</h5>
                        <button class="btn-close btn-close-white" @onclick="CancelCamera"></button>
                    </div>
                    <div class="modal-body p-0 text-center">
                        <video id="cameraVideoElement" autoplay playsinline style="width: 100%; max-height: 400px;"></video>
                    </div>
                    <div class="modal-footer border-0 justify-content-center">
                        <button class="btn btn-light rounded-circle p-3 shadow" style="width: 60px; height: 60px;"
                                onclick="window.cameraInterop.capturePhoto()">
                            <div class="bg-danger rounded-circle w-100 h-100"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int id { get; set; }
    private Trainer? trainer;
    private Trainer editTrainer = new(); // Objek khusus form edit
    private bool isLoading = true;
    private bool canEdit = false;
    private bool isEditModalVisible = false;
    private bool isCameraOpen = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            // 1. Ambil Data Trainer
            trainer = await TrainerService.GetByIdAsync(id);

            // 2. Cek Apakah User Berhak Edit?
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated && trainer != null)
            {
                // Ambil ID User yang login
                var userIdString = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(userIdString, out int currentUserId))
                {
                    // 🔥 Logic: Boleh Edit jika Role=Admin ATAU (Role=Trainer DAN ID-nya Cocok)
                    bool isAdmin = user.IsInRole("Admin");
                    bool isMyProfile = user.IsInRole("Trainer") && trainer.UserId == currentUserId;

                    if (isAdmin || isMyProfile)
                    {
                        canEdit = true;
                    }
                }
            }
        }
        catch
        {
            // Handle error silently
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowEditModal()
    {
        if (trainer != null)
        {
            // Clone data ke objek edit (biar kalau batal, data asli gak berubah)
            editTrainer = new Trainer
            {
                TrainerId = trainer.TrainerId,
                UserId = trainer.UserId,
                Name = trainer.Name,
                Email = trainer.Email,
                Expertise = trainer.Expertise,
                Bio = trainer.Bio,
                FotoProfil = trainer.FotoProfil
            };
            isEditModalVisible = true;
        }
    }

    private void CloseModal() => isEditModalVisible = false;

    private async Task HandleUpdate()
    {
        if (!ConnectivityService.IsConnected())
        {
            await JS.InvokeVoidAsync("alert", "Anda sedang Offline!");
            return;
        }

        var success = await TrainerService.UpdateAsync(editTrainer.TrainerId, editTrainer);
        if (success)
        {
            await JS.InvokeVoidAsync("alert", "Profil berhasil diperbarui!");
            isEditModalVisible = false;
            // Reload data
            trainer = await TrainerService.GetByIdAsync(id);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Gagal memperbarui profil.");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var fileName = await TrainerService.UploadCoverAsync(e.File, editTrainer.FotoProfil);
        if (!string.IsNullOrEmpty(fileName)) editTrainer.FotoProfil = fileName;
    }

    private async Task HandleCameraStart()
    {
        isCameraOpen = true; StateHasChanged(); await Task.Delay(100);
        var stream = await CameraService.TakePhotoAsync();
        if (stream != null)
        {
            var fileName = await TrainerService.UploadStreamAsync(stream, editTrainer.FotoProfil);
            editTrainer.FotoProfil = fileName;
        }
        isCameraOpen = false; StateHasChanged();
    }

    private async Task CancelCamera()
    {
        try { await JS.InvokeVoidAsync("cameraInterop.stopCamera"); } catch { }
        isCameraOpen = false; StateHasChanged();
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private async Task ShareTrainer()
    {
        if (trainer != null)
        {
            await ShareService.ShareTextAsync(
                $"Trainer: {trainer.Name}",
                $"Cek profil {trainer.Name}, ahli di bidang {trainer.Expertise}.",
                Nav.Uri
            );
        }
    }
}