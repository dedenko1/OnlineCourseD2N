@using Microsoft.AspNetCore.Components.Authorization
@using OnlineCourseD2N.Shared.Layout

<CascadingAuthenticationState>

    <Router AppAssembly="typeof(MainLayout).Assembly">
        <Found Context="routeData">

            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">

                <NotAuthorized>
                    <div class="d-flex flex-column align-items-center justify-content-center vh-100">
                        <h2 class="text-danger">Akses Ditolak! 🚫</h2>
                        <p>Anda harus login untuk mengakses halaman ini.</p>
                        <a href="" class="btn btn-primary">Ke Halaman Login</a>
                    </div>
                </NotAuthorized>

                <Authorizing>
                    <div class="text-center p-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p>Memeriksa status login...</p>
                    </div>
                </Authorizing>

            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>

        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <div class="text-center p-5">
                    <h3>404 - Halaman Tidak Ditemukan</h3>
                    <p>Maaf, alamat yang Anda tuju tidak ada.</p>
                    <a href="/home" class="btn btn-secondary">Kembali ke Home</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>

</CascadingAuthenticationState>